# كلمة مرور قاعدة البيانات
DB_PASSWORD=change-this-db-password
# المنفذ الذي يفتح عليه التطبيق في الخادم
WEB_PORT=8080

# سلسلة عشوائية طويلة لتوقيع الجلسات (مثلًا: openssl rand -hex 32)
SOLAR_JWT_SECRET=change-this-to-a-long-random-string
# أول مدير (يُنشأ مرة واحدة عند أول تشغيل)
SOLAR_ADMIN_EMAIL=admin@example.com
SOLAR_ADMIN_PASSWORD=change-me-now
SOLAR_ADMIN_NAME=مدير النظام
# عنوان التطبيق كما يفتحه المستخدمون
SOLAR_CORS_ORIGINS=["http://localhost:8080"]

# بيانات الشركة في التقرير
SOLAR_COMPANY_NAME=طاقات بديلة
SOLAR_COMPANY_PHONE=
SOLAR_COMPANY_EMAIL=
SOLAR_COMPANY_ADDRESS=الرياض، المملكة العربية السعودية
SOLAR_QUOTE_VALIDITY_DAYS=15
